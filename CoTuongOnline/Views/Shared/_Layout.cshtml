<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cờ Tướng · Chơi cùng bạn bè</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header"><a class="brand" href="/">象 <span>Cờ Tướng</span></a><span class="tagline">Một bàn cờ, hai người bạn</span><div id="identity" hidden><span id="username"></span><button id="logout" class="quiet">Đăng xuất</button></div></header>
    <main>@RenderBody()</main>
    <footer>Cờ Tướng Online · Dự án nhóm</footer>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true" defer></script>
    <script src="~/js/app.js" asp-append-version="true" type="module"></script>
</body>
</html>
